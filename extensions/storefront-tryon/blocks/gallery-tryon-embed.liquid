{% comment %}
  3D OUTFIT — 商品メディアギャラリー最終スライド（App Embed）
  Helio（Horizon 系）の media-gallery / slideshow-slide に「3D試着」を末尾追加する。
  既存の App Block「3D試着（単独ブロック）」は任意フォールバック。
{% endcomment %}

{% if request.page_type == 'product' and product %}
  <script
    type="application/json"
    id="OutfitGalleryTryOnConfig-{{ block.id }}"
    data-outfit-gallery-config
  >
    {
      "blockId": {{ block.id | json }},
      "productId": {{ product.id | json }},
      "productTitle": {{ product.title | json }},
      "shop": {{ shop.permanent_domain | json }},
      "proxyPath": "/apps/3d-outfit/tryon",
      "apiBase": {{ block.settings.api_base_url | json }},
      "threeBundle": {{ 'try-on-three.bundle.js' | asset_url | json }},
      "bodyMaleData": {{ 'body-male-data.js' | asset_url | json }},
      "bodyFemaleData": {{ 'body-female-data.js' | asset_url | json }},
      "garmentColor": {{ block.settings.garment_color | default: '#3d5a80' | json }},
      "defaultHeight": {{ block.settings.default_height | default: 170 }},
      "defaultWeight": {{ block.settings.default_weight | default: 60 }},
      "heading": {{ block.settings.heading | default: '3D試着' | json }},
      "subheading": {{ block.settings.subheading | default: '体型を入力して360°で試着確認' | json }},
      "enabled": {% if block.settings.enabled %}true{% else %}false{% endif %}
    }
  </script>

  <template id="OutfitGalleryTryOnTemplate-{{ block.id }}" data-outfit-gallery-template>
    <div
      class="outfit-tryon outfit-tryon--gallery"
      data-outfit-tryon
      data-outfit-gallery-slide
      data-product-id="{{ product.id }}"
      data-product-title="{{ product.title | escape }}"
      data-shop="{{ shop.permanent_domain }}"
      data-proxy-path="/apps/3d-outfit/tryon"
      data-api-base="{{ block.settings.api_base_url | escape }}"
      data-three-bundle="{{ 'try-on-three.bundle.js' | asset_url }}"
      data-garment-color="{{ block.settings.garment_color | default: '#3d5a80' | escape }}"
    >
      <div class="outfit-tryon__gallery-stage">
        <div class="outfit-tryon__canvas-wrap" data-tryon-canvas-wrap>
          <button
            type="button"
            class="outfit-tryon__drawer-trigger"
            data-tryon-drawer-toggle
            aria-expanded="false"
            aria-controls="OutfitTryOnDrawer-{{ block.id }}"
            title="体型設定"
          >
            <span class="outfit-tryon__drawer-trigger-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
                <circle cx="12" cy="12" r="3"></circle>
                <path d="M12 2v2.2M12 19.8V22M4.2 4.2l1.6 1.6M18.2 18.2l1.6 1.6M2 12h2.2M19.8 12H22M4.2 19.8l1.6-1.6M18.2 5.8l1.6-1.6"></path>
              </svg>
            </span>
            <span class="visually-hidden">体型設定を開く</span>
          </button>

          <div
            class="outfit-tryon__layer-toggles"
            data-tryon-layer-toggles
            data-outfit-interactive
            role="group"
            aria-label="表示レイヤー"
          >
            <button
              type="button"
              class="outfit-tryon__layer-btn"
              data-tryon-layer="body"
              aria-pressed="false"
            >
              人体モデル
            </button>
            <button
              type="button"
              class="outfit-tryon__layer-btn is-active"
              data-tryon-layer="product"
              aria-pressed="true"
            >
              商品
            </button>
          </div>

          <div
            class="outfit-tryon__build-badge"
            data-tryon-build-badge
            title="3D OUTFIT build"
          >tryon v23-GARM2</div>
          <canvas data-tryon-canvas aria-label="3D試着ビューア"></canvas>
          <div class="outfit-tryon__overlay" data-tryon-overlay>
            商品プレビューを表示中。右上の設定から体型を入力すると人体モデルも表示できます。
          </div>

          <aside
            class="outfit-tryon__drawer"
            id="OutfitTryOnDrawer-{{ block.id }}"
            data-tryon-drawer
            data-outfit-interactive
            hidden
          >
            <div class="outfit-tryon__drawer-head">
              <strong>体型設定</strong>
              <button type="button" class="outfit-tryon__drawer-close" data-tryon-drawer-close aria-label="閉じる">×</button>
            </div>
            <form class="outfit-tryon__form outfit-tryon__form--compact" data-tryon-form novalidate action="#" method="post">
              {% render 'try-on-form-fields', default_height: block.settings.default_height, default_weight: block.settings.default_weight %}
            </form>
          </aside>
        </div>
        <p class="outfit-tryon__hint" data-tryon-hint>
          左右にドラッグで360°回転（拡大なし・上下固定）
        </p>
        <p class="outfit-tryon__status" data-tryon-status></p>
      </div>

      <details class="outfit-tryon__limitations outfit-tryon__limitations--compact">
        <summary>表示の制限事項</summary>
        <ul data-tryon-limitations>
          <li>実 TRELLIS 生成は未接続のため、服はプレースホルダの場合があります。</li>
          <li>人体は MakeHuman/MPFB 系 CC0 メッシュを身長・体重・性別でスケールしたプレビューです。</li>
        </ul>
      </details>
    </div>
  </template>

  {% comment %}
    STABLE embed UUID for Helio (do NOT retarget in settings_data):
    shopify://apps/3d-outfit/blocks/gallery-tryon-embed/01a19540-d48d-7ee0-bc02-24b3c770447a
    v21 — LIVE canary; embed UUID must match deploy manifest; GLTFLoader.parse(ArrayBuffer); force MakeHuman; fetch preload
  {% endcomment %}
  <script src="{{ 'body-male-data.js' | asset_url | append: '&v=23garm2' }}" defer></script>
  <script src="{{ 'body-female-data.js' | asset_url | append: '&v=23garm2' }}" defer></script>
  <script src="{{ 'garment-sample-data.js' | asset_url | append: '&v=23garm2' }}" defer></script>
  <script src="{{ 'try-on.js' | asset_url | append: '&v=23garm2' }}" defer></script>
  <script src="{{ 'gallery-tryon.js' | asset_url | append: '&v=23garm2' }}" defer></script>
{% endif %}

{% schema %}
{
  "name": "t:gallery_embed.name",
  "target": "body",
  "stylesheet": "try-on.css",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "t:gallery_embed.settings.enabled.label",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading.label",
      "default": "3D試着"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "t:settings.subheading.label",
      "default": "体型を入力して360°で試着確認"
    },
    {
      "type": "text",
      "id": "api_base_url",
      "label": "t:settings.api_base_url.label",
      "info": "t:settings.api_base_url.info"
    },
    {
      "type": "color",
      "id": "garment_color",
      "label": "t:settings.garment_color.label",
      "default": "#3d5a80"
    },
    {
      "type": "number",
      "id": "default_height",
      "label": "t:settings.default_height.label",
      "default": 170
    },
    {
      "type": "number",
      "id": "default_weight",
      "label": "t:settings.default_weight.label",
      "default": 60
    }
  ]
}
{% endschema %}
