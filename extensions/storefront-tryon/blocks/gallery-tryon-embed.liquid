{% comment %}
  3D OUTFIT — 商品メディアギャラリー最終スライド（App Embed）
  Helio（Horizon 系）の media-gallery / slideshow-slide に「3D試着」を末尾追加する。
  既存の App Block「3D試着ビューア」は単独配置のフォールバックとして残す。
{% endcomment %}

{% if request.page_type == 'product' and product %}
  <script
    type="application/json"
    id="OutfitGalleryTryOnConfig-{{ block.id }}"
    data-outfit-gallery-config
  >
    {
      "blockId": {{ block.id | json }},
      "productId": {{ product.id | json }},
      "productTitle": {{ product.title | json }},
      "shop": {{ shop.permanent_domain | json }},
      "proxyPath": "/apps/3d-outfit/tryon",
      "apiBase": {{ block.settings.api_base_url | json }},
      "threeBundle": {{ 'try-on-three.bundle.js' | asset_url | json }},
      "autoRotate": {% if block.settings.auto_rotate %}true{% else %}false{% endif %},
      "garmentColor": {{ block.settings.garment_color | default: '#3d5a80' | json }},
      "defaultHeight": {{ block.settings.default_height | default: 170 }},
      "defaultWeight": {{ block.settings.default_weight | default: 60 }},
      "heading": {{ block.settings.heading | default: '3D試着' | json }},
      "subheading": {{ block.settings.subheading | default: '体型を入力して360°で試着確認' | json }},
      "formMode": {{ block.settings.form_mode | default: 'details' | json }},
      "enabled": {% if block.settings.enabled %}true{% else %}false{% endif %}
    }
  </script>

  <template id="OutfitGalleryTryOnTemplate-{{ block.id }}" data-outfit-gallery-template>
    <div
      class="outfit-tryon outfit-tryon--gallery"
      data-outfit-tryon
      data-outfit-gallery-slide
      data-product-id="{{ product.id }}"
      data-product-title="{{ product.title | escape }}"
      data-shop="{{ shop.permanent_domain }}"
      data-proxy-path="/apps/3d-outfit/tryon"
      data-api-base="{{ block.settings.api_base_url | escape }}"
      data-three-bundle="{{ 'try-on-three.bundle.js' | asset_url }}"
      data-auto-rotate="{% if block.settings.auto_rotate %}true{% else %}false{% endif %}"
      data-garment-color="{{ block.settings.garment_color | default: '#3d5a80' | escape }}"
    >
      <div class="outfit-tryon__gallery-badge" aria-hidden="true">3D試着</div>

      <div class="outfit-tryon__gallery-stage">
        <div class="outfit-tryon__canvas-wrap" data-tryon-canvas-wrap>
          <canvas data-tryon-canvas aria-label="3D試着ビューア"></canvas>
          <div class="outfit-tryon__overlay" data-tryon-overlay>
            体型を入力して試着を開始してください
          </div>
        </div>
        <p class="outfit-tryon__hint" data-tryon-hint>
          ドラッグで回転・ピンチで拡大
        </p>
        <p class="outfit-tryon__status" data-tryon-status></p>
      </div>

      {% if block.settings.form_mode == 'modal' %}
        <div class="outfit-tryon__gallery-cta-row">
          <button type="button" class="outfit-tryon__btn outfit-tryon__btn--primary" data-tryon-open-form>
            体型を入力して試着
          </button>
          <button type="button" class="outfit-tryon__btn" data-tryon-toggle-rotate>
            自動回転 ON/OFF
          </button>
        </div>
        <dialog class="outfit-tryon__dialog" data-tryon-dialog>
          <form method="dialog" class="outfit-tryon__dialog-chrome">
            <strong class="outfit-tryon__dialog-title">{{ block.settings.heading | default: '3D試着' }}</strong>
            <button type="submit" class="outfit-tryon__dialog-close" value="cancel" aria-label="閉じる">×</button>
          </form>
          <form class="outfit-tryon__form outfit-tryon__form--compact" data-tryon-form novalidate>
            {% render 'try-on-form-fields', default_height: block.settings.default_height, default_weight: block.settings.default_weight %}
          </form>
        </dialog>
      {% else %}
        <details class="outfit-tryon__gallery-form" data-tryon-form-panel open>
          <summary>体型を入力</summary>
          <form class="outfit-tryon__form outfit-tryon__form--compact" data-tryon-form novalidate>
            {% render 'try-on-form-fields', default_height: block.settings.default_height, default_weight: block.settings.default_weight %}
          </form>
        </details>
        <div class="outfit-tryon__gallery-cta-row">
          <button type="button" class="outfit-tryon__btn" data-tryon-toggle-rotate>
            自動回転 ON/OFF
          </button>
        </div>
      {% endif %}

      <details class="outfit-tryon__limitations outfit-tryon__limitations--compact">
        <summary>表示の制限事項</summary>
        <ul data-tryon-limitations>
          <li>実 TRELLIS 生成は未接続のため、服はプレースホルダの場合があります。</li>
          <li>マネキンは身長・体重などからの簡易パラメトリック体型です。</li>
        </ul>
      </details>
    </div>
  </template>

  <script src="{{ 'try-on.js' | asset_url }}" defer></script>
  <script src="{{ 'gallery-tryon.js' | asset_url }}" defer></script>
{% endif %}

{% schema %}
{
  "name": "t:gallery_embed.name",
  "target": "body",
  "stylesheet": "try-on.css",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "t:gallery_embed.settings.enabled.label",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading.label",
      "default": "3D試着"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "t:settings.subheading.label",
      "default": "体型を入力して360°で試着確認"
    },
    {
      "type": "select",
      "id": "form_mode",
      "label": "t:gallery_embed.settings.form_mode.label",
      "options": [
        {
          "value": "details",
          "label": "t:gallery_embed.settings.form_mode.options.details"
        },
        {
          "value": "modal",
          "label": "t:gallery_embed.settings.form_mode.options.modal"
        }
      ],
      "default": "details"
    },
    {
      "type": "text",
      "id": "api_base_url",
      "label": "t:settings.api_base_url.label",
      "info": "t:settings.api_base_url.info"
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "t:settings.auto_rotate.label",
      "default": true
    },
    {
      "type": "color",
      "id": "garment_color",
      "label": "t:settings.garment_color.label",
      "default": "#3d5a80"
    },
    {
      "type": "number",
      "id": "default_height",
      "label": "t:settings.default_height.label",
      "default": 170
    },
    {
      "type": "number",
      "id": "default_weight",
      "label": "t:settings.default_weight.label",
      "default": 60
    }
  ]
}
{% endschema %}
