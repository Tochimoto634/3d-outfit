{% comment %}
  Shared compact try-on form fields (Japanese UI).
  @param default_height {number}
  @param default_weight {number}
{% endcomment %}
<fieldset class="outfit-tryon__fieldset">
  <legend>基本（必須）</legend>

  <div class="outfit-tryon__field-row">
    <label class="outfit-tryon__field">
      <span>身長（cm）</span>
      <input
        type="number"
        name="heightCm"
        inputmode="decimal"
        min="120"
        max="220"
        step="0.1"
        required
        placeholder="170"
        value="{{ default_height | default: 170 }}"
      >
    </label>

    <label class="outfit-tryon__field">
      <span>体重（kg）</span>
      <input
        type="number"
        name="weightKg"
        inputmode="decimal"
        min="30"
        max="200"
        step="0.1"
        required
        placeholder="60"
        value="{{ default_weight | default: 60 }}"
      >
    </label>
  </div>

  <label class="outfit-tryon__field">
    <span>性別</span>
    <select name="gender" required>
      <option value="" disabled selected>選択してください</option>
      <option value="female">女性</option>
      <option value="male">男性</option>
      <option value="unspecified">指定しない</option>
    </select>
  </label>
</fieldset>

<details class="outfit-tryon__more">
  <summary>詳細サイズ（任意）</summary>
  <fieldset class="outfit-tryon__fieldset">
    <legend>スリーサイズ</legend>
    <div class="outfit-tryon__field-row">
      <label class="outfit-tryon__field">
        <span>バスト</span>
        <input type="number" name="bustCm" inputmode="decimal" min="50" max="160" step="0.1" placeholder="cm">
      </label>
      <label class="outfit-tryon__field">
        <span>ウエスト</span>
        <input type="number" name="waistCm" inputmode="decimal" min="40" max="160" step="0.1" placeholder="cm">
      </label>
      <label class="outfit-tryon__field">
        <span>ヒップ</span>
        <input type="number" name="hipCm" inputmode="decimal" min="50" max="180" step="0.1" placeholder="cm">
      </label>
    </div>
  </fieldset>
</details>

<p class="outfit-tryon__error" data-tryon-error hidden></p>

<div class="outfit-tryon__actions">
  <button type="submit" class="outfit-tryon__btn outfit-tryon__btn--primary" data-tryon-submit>
    マネキンを作成して試着
  </button>
</div>
