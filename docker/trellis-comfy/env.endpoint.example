# Copy values into the RunPod Serverless Endpoint → Environment Variables UI.
# Do NOT put real secrets in git. Do NOT put these in the Shopify app .env
# (app only needs RUNPOD_API_KEY + RUNPOD_ENDPOINT_ID).

# --- Required for durable https GLB URLs (S3 or Cloudflare R2) ---
BUCKET_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
BUCKET_ACCESS_KEY_ID=
BUCKET_SECRET_ACCESS_KEY=
BUCKET_NAME=your-glb-bucket
# Optional CDN / public base so URLs are stable https (preferred over long-lived presign)
BUCKET_PUBLIC_BASE_URL=https://glb.example.com
BUCKET_PREFIX=3d-outfit/glb

# --- Optional ---
# AWS_DEFAULT_REGION=auto
# BUCKET_PRESIGN_EXPIRES=604800
# NETWORK_VOLUME_DEBUG=1
