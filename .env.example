# Shopify (通常は `shopify app dev` が注入。手動実行時のみ設定)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=write_products,read_products
SHOPIFY_APP_URL=https://example.com

# SQLite (Prisma) — デフォルトで file:dev.sqlite
# DATABASE_URL="file:dev.sqlite"

# RunPod / ComfyUI / TRELLIS.2
# APIキー未設定時はモックモードで動作（秘密情報をリポジトリに置かないこと）
# Docs: docs/runpod-live-connect.md  /  dry-run: npm run dry-run:runpod
RUNPOD_API_KEY=
# NEW Serverless Endpoint ID for 3D OUTFIT only (ComfyUI + TRELLIS.2).
# Do NOT reuse unrelated project endpoints (e.g. silent_maroon_roundworm, wrong_rose_canidae).
# Copy Endpoint ID from RunPod Console → Serverless → your new endpoint detail page.
RUNPOD_ENDPOINT_ID=
# RUNPOD_API_BASE=https://api.runpod.ai/v2
# RUNPOD_FORCE_MOCK=1
# RUNPOD_DRY_RUN=1

# Optional: ComfyUI workflow graph (JSON object). Inline wins over path.
# RUNPOD_WORKFLOW_JSON=
# RUNPOD_WORKFLOW_PATH=config/runpod-trellis-workflow.json
